# Copy to web/.env.local and fill in.

# Privy (wallet + auth). Create an app at dashboard.privy.io and allow Monad testnet.
# Without this the app still runs using an injected browser wallet.
NEXT_PUBLIC_PRIVY_APP_ID=

# Deployed Monad testnet contract addresses (filled in after the deploy).
NEXT_PUBLIC_BUZZME=
NEXT_PUBLIC_GACHA_POT=
