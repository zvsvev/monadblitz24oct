{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buzzme",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "buzzme"
    }
  ],
  "observability": {
    "enabled": true
  }
  // Off-chain store. Enable after creating the D1 database and putting its id here:
  // (the deploy token needs D1: Edit, or create the database in the dashboard).
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "buzzme", "database_id": "<D1_DATABASE_ID>" }
  // ]
}
